3. Suponha que você foi encarregado de construir um programa em linguagem C que
simule o funcionamento do computador de bordo de um veículo que deverá, a partir
da distância percorrida e da quantidade consumida de litros de combustível desde o
último abastecimento, exibir na tela o consumo médio (Km/L) e a autonomia restante
do veículo (em Km), assumindo que no último abastecimento foram colocados 50 litros
de combustível.

#include <stdio.h>
int main()
{
    //declaracao de variaveis
    float distanciaPercorrida, quantidadeLitro;
    float consumoMedio, autonomia;

    //entrada
    printf("\nDigite a distancia percorrida em km:");
    scanf("%f", &distanciaPercorrida);
    printf("\nDigite a quantidade consumida em litros de combustivel por km:");
    scanf("%f", &quantidadeLitro);

    //processamento
    consumoMedio = distanciaPercorrida / quantidadeLitro;
    autonomia = 50 - consumoMedio;

    //saida
    printf("\nConsumo medio de %.2f", consumoMedio);
    printf("\nAutonomia restante de %.2f litros", autonomia);

    return 1;
}
