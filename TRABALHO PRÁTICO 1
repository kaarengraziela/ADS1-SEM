5. Construa um programa em linguagem C que simule o funcionamento de uma
máquina de venda de bebidas. Suponha que a opção 1 refere-se à venda de
Refrigerante em Lata, que custa R$ 3,00 cada um. A opção 2 refere-se à venda de Suco
Natural, que custa R$ 2,50 cada um. O programa deverá ler do teclado um valor int
(que equivale à opção de bebida) e um valor float (que equivale ao valor pago pelo
comprador). Se o valor inteiro for igual a 1, deverá imprimir na tela a mensagem
“Refrigerante”, assim como calcular e imprimir o valor do troco (valor pago – R$ 3,00).
Se o valor for igual a 2, deverá imprimir na tela a mensagem “Suco”, assim como
calcular e imprimir o valor do troco (valor pago – R$ 2,50). Se for diferente de 1 e 2,
imprimir a mensagem “Valor Inválido” na tela. Para ambas as opções, caso o valor
pago seja inferior ao valor da bebida selecionada, o programa deverá imprimir a
mensagem “Dinheiro insuficiente”

#include <stdio.h>
int main ()
{
    //entrada
    int bebida;
    float troco, dinheiro;
    float refrigerante = 3.00;
    float suco = 2.50;

    //entrada de dados
    printf("\nInsira seu dinheiro na maquina: R$");
    scanf("%f", &dinheiro);

    printf("\n 1 - Refrigerante em Lata \n 2 - Suco natural\n \nSelecione sua opcao de bebida: ");
    scanf("%i", &bebida);

    //processamento e saida0
    switch (bebida)
    {
        case 1: printf("\nRefrigerante em Lata");
            if(dinheiro<refrigerante)
            {
            printf("\nDinheiro insuficiente\n");
            }
            else
            {
            troco = dinheiro - refrigerante;
            printf("\nValor pago: R$3.00 \nSeu troco eh R$%.2f \n", troco);
            } break;
        case 2: printf("\nSuco natural");
            if(dinheiro<suco)
            {
            printf("\nDinheiro insuficiente\n");
            }
            else
            {
            troco = dinheiro - suco;
            printf("\nValor pago: R$2.50 \nSeu troco eh R$%.2f \n", troco);
            }
            break;
        default: printf("\nOpcao Invalida\n");
    }

    return 1;
}
