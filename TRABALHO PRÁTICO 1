    scanf("%i", &pedicure);

    printf("\nEscolha seu cupom de desconto \n5%% - 10%% - 15%%: ");
    scanf("%i", &cupomDesconto);

    if(cupomDesconto != 5 && cupomDesconto != 10 && cupomDesconto != 15)
    {
        printf("\nValor invalido! Digite novamente: ");
        scanf("%i", &cupomDesconto);
    }

    //processamento
    switch (cabelo)
    {
        case 0: break;
        default: valorTotal = 30; break;
    }
    switch (barba)
    {
        case 0: break;
        default: valorTotal = valorTotal + 40; break;
    }
    switch (manicure)
    {
        case 0: break;
        default: valorTotal = valorTotal + 15; break;
    }
    switch (pedicure)
    {
        case 0: break;
        default: valorTotal = valorTotal + 50; break;
    }

    if(cabelo != 0 && barba != 0 && manicure != 0 && pedicure != 0)
       {
        valorTotal = valorTotal - 15;
        valorTotal = valorTotal - (valorTotal * cupomDesconto/100);
        printf("\nValor total: R$%.2f\n", valorTotal);
       }

    else
        {
        valorTotal = valorTotal - (valorTotal * cupomDesconto/100);
        printf("\nValor total: R$%.2f\n", valorTotal);
        }


return 1;
