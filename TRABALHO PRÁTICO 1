        scanf("%i", &antiFurto);
        }
        
    printf("\nQuantos pontos o condutor principal tem na carteira de habilitacao?");
    scanf("%i", &pontosHabilitacao);
        if (pontosHabilitacao==0)
            {
                desconto += 5;
            }
        else if (pontosHabilitacao <= 7)
            {
                desconto += 4;
            }
        else if (pontosHabilitacao <= 12)
            {
                desconto += 3;
            }
        else if (pontosHabilitacao <= 17)
            {
                desconto += 2;
            }
        else
            {
                desconto += 0;
            }
    printf("\nVoce tera %i%% de desconto em suas apolices.", desconto);
    
    printf("\nQual do valor bruto da apolice? R$");
    scanf("%f", &valorApolice);
    
    valorComDesconto = valorApolice - (valorApolice*desconto/100);
    
    printf("\nCom desconto, o valor da sua apolice sera de R$%.2f", valorComDesconto);


    return 1;    
}
