2. Construa um programa em linguagem C que leia o peso de uma carga e a distância
a ser percorrida por um caminhoneiro para, em seguida, calcular e imprimir na tela o
preço a ser pago pelo frete, levando em consideração que o dono do caminhão cobra R$
2,25 por quilo de produto carregado mais R$ 3,34 por quilômetro rodado.

#include <stdio.h>
int main ()
{
    //declaracao
    float pesoCarga, distanciaPercorrida, valorFrete;
    float valorKg = 2.25;
    float valorKm = 3.34;

    //entrada
    printf("\nDigite o peso da carga:");
    scanf("%f", &pesoCarga);
    printf("\nDigite a distancia percorrida:");
    scanf("%f", &distanciaPercorrida);

    //processamento
    valorFrete = (valorKg*pesoCarga)+(valorKm*distanciaPercorrida);

    //saida de dados
    printf("\nO valor a ser pago pelo frete sera %.2f\n", valorFrete);

    return 1;


}
