6. As Lojas Pernancubanas vendem produtos à vista ou a prazo. Se a venda é à vista o
cliente recebe 10% de desconto no valor total da compra. Caso seja uma venda a prazo,
o cliente não tem desconto mas pode escolher pagar em até 6 prestações. Construa um
programa em linguagem C que leia do teclado o valor total da compra (float), assim
como o tipo de venda escolhida pelo cliente (char), onde ‘V’ significa venda à vista e
‘P’ significa venda a prazo. Se o cliente escolher a venda à vista o programa deverá
exibir na tela o valor a ser pago, já com o desconto de 10% sobre o valor total. Se o
cliente escolher venda a prazo, o programa deverá ler do teclado o número de
prestações escolhidas pelo cliente (int) e exibir na tela o valor de cada prestação. Se o
número de prestações escolhidas pelo cliente for superior a 6, o programa deverá exibir
a mensagem “Número incorreto de prestações”. Caso o cliente não escolha ‘V’
ou ‘P’ como tipo da venda, o programa deverá exibir na tela a mensagem “opção
inválida”.

#include <stdio.h>
int main()
{
    //declaracao
    char tipoVenda;
    float totalCompra, valorComDesconto, valorPrestacoes;
    int prestacoes;

    //entrada
    printf("\nValor total da compra:R$");
    scanf("%f", &totalCompra);
    printf("\n V - Ah vista \n P - Ah prazo\n \nQual sera a forma de pagamento: ");
    scanf(" %c", &tipoVenda);

    //processamnto e saida
    switch (tipoVenda)
    {
        case 'v':
        case 'V': printf("\nPagamento ah vista");
            valorComDesconto = totalCompra * 0.90;
            printf("\nValor com desconto: R$%.2f\n", valorComDesconto);
            break;

        case 'p':
        case 'P': printf("\nPagamento ah prazo");
            printf("\nQuantas prestacoes: ");
            scanf("%i", &prestacoes);

            if (prestacoes <= 0)
            {
            printf("\nNumero incorreto de prestacoes!\n");
            }
            else

            if (prestacoes <= 6)
            {
                valorPrestacoes = totalCompra / prestacoes;
                printf("\nO valor de cada prestacao eh de R$%.2f\n", valorPrestacoes);
            }
            else
            {
            printf("\nNumero incorreto de prestacoes!\n");
            }
            break;

        default: printf("\nOpcao Invalida\n");

    }

return 1;
}
