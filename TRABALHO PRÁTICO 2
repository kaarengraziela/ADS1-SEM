01. Uma vinícola contratou um sommelier para avaliar a qualidade dos vinhos produzidos. A
tarefa do sommelier é aprovar (ou não) o vinho com base em dois critérios:
● Acidez: o vinho é reprovado se a acidez for alta (código 'A'), sendo aprovado em caso
contrário.
● Aroma: o vinho é aprovado se apresentar aroma frutado (código 'F'), floral (código
'L') ou amadeirado (código 'M'), sendo reprovado em caso contrário.
Construa um programa em linguagem C para auxiliar o sommelier. O programa deverá ler do
teclado a acidez e o aroma de uma amostra de vinho para, em seguida, informar na tela se o
vinho foi aprovado ou reprovado, de acordo com os critérios estabelecidos.

#include <stdio.h>
int main ()

{
    //declaracao de variaveis
    char acidez, aroma;
    
    //entrada
    printf("\nQual o nivel de acidez que a amostra de vinho apresenta: ");
    scanf(" %c", &acidez);
    
    //processamento e saida
    switch (acidez)
    {
        case 'A':
        case 'a': 
        printf("\nReprovado! Vinho com acidez alta.\n"); break;
            
        default:
        { 
            printf("\nQual o aroma da amostra de vinho: ");
            scanf(" %c", &aroma);
        
            switch (aroma)
                {
                case 'f':
                case 'F': printf("\nAroma FRUTADO. Vinho Aprovado!"); break;
                case 'l':
                case 'L': printf("\nAroma FLORAL. Vinho Aprovado!"); break;
                case 'M':
                case 'm': printf("\nAroma AMADEIRADO. Vinho Aprovado!"); break;
                
                default: printf("\nReprovado"); break;
                }
               
            }
    }
            
return 0;    
}
