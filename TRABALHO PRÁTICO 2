02. Construa um programa em linguagem C que leia o código de um determinado produto e
mostre na tela a sua classificação utilizando a tabela a seguir como referência. O programa
deverá ler o código do produto e classificá-lo corretamente conforme a tabela, exibindo na
tela a classificação correspondente ou a mensagem “Código inválido”, quando for o caso.

#include <stdio.h>
int main ()

{
    //declaracao de variaveis
    int codigo;
    
    //entrada
    printf("\nDigite o codigo do produto: ");
    scanf("%i", &codigo);
    
    while (codigo < 1 || codigo > 14)
    {
        printf("\nCodigo invalido!! Tente novamente: ");
        scanf("%i", &codigo);
    }
    
    if (codigo == 1 || codigo == 2)
    {   printf("\nProduto alimenticio");    }
    else if (codigo >= 3 && codigo <= 5)
    {   printf("\nProduto de limpeza");     }
    else if (codigo == 6)  
    {   printf("\nProduto eletronico");     }
    else if (codigo == 7 || codigo == 8)
    {   printf("\nProduto de vestuário");   }
    else if (codigo >= 9 && codigo <= 12)
    {   printf("\nProduto de higiene pessoal");   }
    else if (codigo == 13 || codigo == 14)
    {   printf("\nProduto hospitalar");     }

return 0;    
}
